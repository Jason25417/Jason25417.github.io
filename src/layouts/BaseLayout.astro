---
import '@fontsource/public-sans/latin-400.css';
import '@fontsource/public-sans/latin-500.css';
import '@fontsource/public-sans/latin-600.css';
import '@fontsource/source-serif-4/latin-400.css';
import '@fontsource/source-serif-4/latin-400-italic.css';
import '@fontsource/source-serif-4/latin-600.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
}

const {
  title,
  description = 'Jason Tu — mathematics and data analytics at The Ohio State University, open-source work on Rust infrastructure, and apps for Apple platforms.',
  type = 'website',
} = Astro.props;

const pageTitle = title ? `${title} · Jason Tu` : 'Jason Tu';
const canonical = new URL(Astro.url.pathname, Astro.site);
const pathname = Astro.url.pathname;

const nav = [
  { href: '/projects/', label: 'Projects' },
  { href: '/writing/', label: 'Writing' },
  { href: '/about/', label: 'About' },
];

const isActive = (href: string) =>
  pathname === href || pathname.startsWith(href);

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Jason Tu" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f7f7f3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#101413" media="(prefers-color-scheme: dark)" />
    <meta property="og:site_name" content="Jason Tu" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="shell">
        <a class="wordmark" href="/">Jason Tu</a>
        <nav aria-label="Primary">
          <ul class="site-nav">
            {
              nav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={isActive(item.href) ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <div class="shell">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="shell">
        <p style="margin: 0">© {year} Jason Tu</p>
        <ul class="footer-links">
          <li><a href="https://github.com/Jason25417" rel="me">GitHub</a></li>
          <li>
            <a href="https://apps.apple.com/developer/id6785333743">App Store</a>
          </li>
          <li><a href="https://arxiv.org/abs/2608.18426">arXiv</a></li>
        </ul>
      </div>
    </footer>
  </body>
</html>
