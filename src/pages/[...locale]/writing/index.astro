---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  formatDate,
  localeInfo,
  localeStaticPaths,
  localizePath,
  rich,
  useTranslations,
  type Locale,
} from '../../../i18n';
import { getPosts } from '../../../i18n/posts';

export const getStaticPaths = localeStaticPaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
const posts = await getPosts(locale);
---

<BaseLayout title={t.writing.title} description={t.writing.description}>
  <header class="page-head">
    <h1>{t.writing.title}</h1>
    <p class="lede">{t.writing.lede}</p>
  </header>

  {
    posts.length > 0 ? (
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <a
              class="post-link"
              href={localizePath(`/writing/${post.slug}/`, locale)}
            >
              <time datetime={post.entry.data.date.toISOString()}>
                {formatDate(post.entry.data.date, locale)}
              </time>
              <div lang={post.isFallback ? localeInfo[post.contentLocale].tag : undefined}>
                <h2>{post.entry.data.title}</h2>
                <p>{post.entry.data.description}</p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <div class="empty">
        <p class="empty-label">{t.writing.emptyLabel}</p>
        <h2>{t.writing.emptyTitle}</h2>
        <p>{t.writing.emptyBody}</p>
        <p set:html={rich(t.writing.emptyCode)} />
      </div>
    )
  }
</BaseLayout>
