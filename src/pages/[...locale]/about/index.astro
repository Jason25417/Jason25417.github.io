---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  localeStaticPaths,
  rich,
  useTranslations,
  type Locale,
} from '../../../i18n';
import { links } from '../../../data/links';

export const getStaticPaths = localeStaticPaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
---

<BaseLayout title={t.about.title} description={t.about.description}>
  <header class="page-head">
    <h1>{t.about.title}</h1>
  </header>

  <div class="prose">
    <p>{t.about.intro}</p>
    <p set:html={rich(t.about.body)} />
  </div>

  <section class="about-aside" aria-labelledby="elsewhere">
    <h2 class="group-title" id="elsewhere">{t.about.elsewhere}</h2>
    <ul class="links">
      <li><a href={links.github.href}>GitHub</a></li>
      <li><a href={links.paper.href}>arXiv</a></li>
      <li>
        <a href={links.appStoreDeveloper.href}>{t.projects.developerPage}</a>
      </li>
    </ul>
  </section>
</BaseLayout>
