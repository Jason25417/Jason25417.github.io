---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  fill,
  formatDate,
  localeInfo,
  localeStaticPaths,
  localizePath,
  useTranslations,
  type Locale,
} from '../../i18n';
import { getLocalizedEntry, getNotes } from '../../i18n/content';
import { getWorkByLine } from '../../i18n/work';

export const getStaticPaths = localeStaticPaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

const intro = await getLocalizedEntry('pages', 'home', locale);
const now = await getLocalizedEntry('pages', 'now', locale);
const { Content: Intro } = await render(intro.entry);
const groups = await getWorkByLine(locale);
const notes = (await getNotes(locale)).slice(0, 3);

/** Marks text shown in English on a page in another language. */
const langOf = (item: { isFallback: boolean; contentLocale: Locale }) =>
  item.isFallback ? localeInfo[item.contentLocale].tag : undefined;
---

<BaseLayout translatedIn={intro.translatedIn} canonicalLocale={intro.contentLocale}>
  <section class="intro" aria-labelledby="intro-title">
    <h1 id="intro-title">Jason Tu</h1>
    <div class="intro-body" lang={langOf(intro)}>
      <Intro />
    </div>
  </section>

  <div class="index">
    <section class="row" aria-labelledby="home-now">
      <h2 class="row-label" id="home-now">
        <a href={localizePath('/now/', locale)}>{t.nav.now}</a>
      </h2>
      <div class="row-body">
        {now.entry.data.summary && <p lang={langOf(now)}>{now.entry.data.summary}</p>}
        <p class="meta">
          {
            now.entry.data.updated && (
              <>
                {fill(t.common.updated, {
                  date: formatDate(now.entry.data.updated, locale),
                })}
                {' · '}
              </>
            )
          }
          <a href={localizePath('/now/', locale)}>{t.home.nowLink} →</a>
        </p>
      </div>
    </section>

    {
      groups.map(({ line, items }) => (
        <section class="row" aria-labelledby={`home-${line}`}>
          <h2 class="row-label" id={`home-${line}`}>
            {t.lines[line]}
          </h2>
          <div class="row-body">
            <ul class="work-list">
              {items.map((item) => (
                <li lang={langOf(item.page)}>
                  <a
                    class="item-name"
                    href={localizePath(`/work/${item.id}/`, locale)}
                  >
                    {item.page.entry.data.title}
                  </a>
                  <span class="dim">{item.page.entry.data.summary}</span>
                </li>
              ))}
            </ul>
          </div>
        </section>
      ))
    }

    {
      notes.length > 0 && (
        <section class="row" aria-labelledby="home-notes">
          <h2 class="row-label" id="home-notes">
            <a href={localizePath('/notes/', locale)}>{t.nav.notes}</a>
          </h2>
          <div class="row-body">
            <ul class="work-list">
              {notes.map((note) => (
                <li lang={langOf(note)}>
                  <a
                    class="item-name"
                    href={localizePath(`/notes/${note.slug}/`, locale)}
                  >
                    {note.entry.data.title}
                  </a>
                  <span class="dim">{note.entry.data.description}</span>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }
  </div>

  <p class="section-foot">
    <a href={localizePath('/work/', locale)}>{t.home.allWork} →</a>
    {
      notes.length > 0 && (
        <a href={localizePath('/notes/', locale)}>{t.home.allNotes} →</a>
      )
    }
  </p>
</BaseLayout>
