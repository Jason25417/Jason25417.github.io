---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (
  await getCollection('writing', ({ data }) => !data.draft)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const dateFormat = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<BaseLayout
  title="Writing"
  description="Notes by Jason Tu on mathematics, Rust, and building software."
>
  <header class="page-head">
    <h1>Writing</h1>
    <p class="lede">
      Notes on mathematics, Rust, and building software, for the things that
      don't fit in a paper or a pull request.
    </p>
  </header>

  {
    posts.length > 0 ? (
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <a class="post-link" href={`/writing/${post.id}/`}>
              <time datetime={post.data.date.toISOString()}>
                {dateFormat.format(post.data.date)}
              </time>
              <div>
                <h2>{post.data.title}</h2>
                <p>{post.data.description}</p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <div class="empty">
        <p class="empty-label">No posts yet</p>
        <h2>The longer notes will live here.</h2>
        <p>
          Mathematics, Rust internals, and what I learn building apps. Nothing
          is published yet; the first post will appear at this address.
        </p>
        <p>
          In the meantime, the code is on{' '}
          <a href="https://github.com/Jason25417">GitHub</a>.
        </p>
      </div>
    )
  }
</BaseLayout>
